# ESP32-C3 boards (esp32-2424s012): single core, 400 KB SRAM, no PSRAM. Listed by
# CMakeLists.txt between sdkconfig.defaults and boards/<board>.defaults.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_LVGL_PORT_TASK_CORE=-1
CONFIG_LVGL_PORT_TASK_STACK_SIZE_KB=8
# 4 MB flash = 1.9 MB app slots: optimise for size (-O2 left only ~12 % free)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# No PSRAM: smaller WiFi/lwIP buffers (defaults: 10 static RX, 32 dynamic RX/TX), and the
# WiFi code in flash: on the C3, IRAM comes out of the same SRAM as the heap.
# (CONFIG_ESP_WIFI_* is what the WiFi driver and its linker script read.)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_MAX_SOCKETS=10
# Single core: the OTA image check (SHA-256 over the whole app in esp_ota_end) and flash
# writes keep the idle task from running; 5 s made every web OTA a task-WDT panic.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
